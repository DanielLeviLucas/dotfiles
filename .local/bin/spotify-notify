#!/usr/bin/env bash

readonly COVER_ART_CACHE_DIR="$HOME/.cache/spotify/Data/cover_art_cache"

normalize() {
    local s
    s="$1"
    printf '%s' "${s//\//-}"
}

PLAYER=""

detect_player() {
    local players
    players="$(playerctl -l 2>/dev/null || true)"

    if grep -Fxq 'spotifast' <<<"$players"; then
        PLAYER="spotifast"
    elif grep -Fxq 'spotify' <<<"$players"; then
        PLAYER="spotify"
    fi

}


while IFS='*' read -r trackid title artist art_url; do
    detect_player
    echo "current player: "  "'" "$PLAYER" "'"

    [[ -z "$title" ]] && continue

    song_name=$(normalize "$title")
    artist_name=$(normalize "$artist")
    song_uid=$(basename "$art_url")

    cover_art_cache_path="$COVER_ART_CACHE_DIR/$song_uid - $song_name - $artist_name"

    if [[ -e "$cover_art_cache_path" ]]; then
        dunstify "Now Playing" "$artist_name - $song_name" -I "$cover_art_cache_path" -t 3500
    else
        touch "$cover_art_cache_path"
        curl -s "$art_url" --output "$cover_art_cache_path"
        dunstify "Now Playing" "$artist_name - $song_name" -I "$cover_art_cache_path" -t 3500
    fi
done < <(
    playerctl -p "$PLAYER" metadata \
        --format '{{mpris:trackid}}*{{title}}*{{artist}}*{{mpris:artUrl}}' \
        --follow
)
